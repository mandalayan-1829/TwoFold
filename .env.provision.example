# TwoFold - Trusted Couple Provisioning
# Copy to .env.provision.local and fill in real values.
# NEVER commit .env.provision.local.
# NEVER expose the service-role key to frontend code.

SUPABASE_URL=http://127.0.0.1:54321
SUPABASE_SERVICE_ROLE_KEY=

OWNER_USER_ID=
PARTNER_USER_ID=

OWNER_DISPLAY_NAME=
PARTNER_DISPLAY_NAME=

COUPLE_SPACE_NAME=TwoFold
ANNIVERSARY_DATE=
